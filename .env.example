# ─────────────────────────────────────────────
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar este archivo como ".env" y completar
# con los valores reales. NUNCA commitear ".env"
# ─────────────────────────────────────────────

# Ruta al archivo de clave de servicio de Google Cloud (Firestore)
GOOGLE_APPLICATION_CREDENTIALS="<ruta-al-archivo-gcp-key.json>"

# Credenciales del portal Mediación Chile (Segunda Clave)
MEDIACION_RUN="<RUN-sin-puntos-ni-guion>"
MEDIACION_PASSWORD="<tu-segunda-clave>"

# Alternativa: Cookie de sesión si ingresás con ClaveÚnica
# MEDIACION_COOKIE="<valor-de-ASP.NET_SessionId>"

# Webhook de Discord para notificaciones
DISCORD_WEBHOOK_URL="<url-completa-del-webhook-de-discord>"
